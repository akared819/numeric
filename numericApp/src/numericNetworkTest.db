# Test-only synchronous delay forces the client to time out during processing.
record(waveform, "numericNet:event") {
    field(FTVL, "DOUBLE") field(NELM, "5") field(FLNK, "numericNet:delay")
}
record(aSub, "numericNet:delay") {
    field(SNAM, "numericTestDelay") field(FLNK, "numericNet:stats")
}
record(aSub, "numericNet:stats") {
    field(SNAM, "numericAcknowledgedStats")
    field(FTA, "DOUBLE") field(NOA, "5") field(INPA, "numericNet:event NPP NMS")
    field(FTVL, "DOUBLE") field(NOVL, "11")
}
# Test-only chain: inspect the coherent output before allowing the put to finish.
record(waveform, "numericPost:event") {
    field(FTVL, "DOUBLE") field(NELM, "5") field(FLNK, "numericPost:stats")
}
record(aSub, "numericPost:stats") {
    field(SNAM, "numericAcknowledgedStats") field(FLNK, "numericPost:delay")
    field(FTA, "DOUBLE") field(NOA, "5") field(INPA, "numericPost:event NPP NMS")
    field(FTVL, "DOUBLE") field(NOVL, "11")
}
record(aSub, "numericPost:delay") {
    field(SNAM, "numericTestAfterUpdate")
    field(FTA, "DOUBLE") field(NOA, "11") field(INPA, "numericPost:stats.VALL NPP NMS")
}
record(waveform, "numericPartition:event") {
    field(FTVL, "DOUBLE") field(NELM, "5") field(FLNK, "numericPartition:delay")
}
record(aSub, "numericPartition:delay") {
    field(SNAM, "numericTestPartitionDelay") field(FLNK, "numericPartition:stats")
}
record(aSub, "numericPartition:stats") {
    field(SNAM, "numericAcknowledgedStats")
    field(FTA, "DOUBLE") field(NOA, "5") field(INPA, "numericPartition:event NPP NMS")
    field(FTVL, "DOUBLE") field(NOVL, "11")
}
