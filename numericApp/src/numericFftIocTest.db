record(waveform, "smallDest") { field(FTVL, "DOUBLE") field(NELM, "4") }
record(waveform, "integerDest") { field(FTVL, "LONG") field(NELM, "8") }
record(aSub, "smallOutput") {
    field(SNAM, "numericFftForward") field(FTA, "DOUBLE") field(NOA, "9")
    field(INPA, "fftInput NPP NMS") field(FTVA, "DOUBLE") field(NOVA, "4")
}
record(aSub, "smallLink") {
    field(SNAM, "numericFftForward") field(FTA, "DOUBLE") field(NOA, "9")
    field(INPA, "fftInput NPP NMS") field(FTVA, "DOUBLE") field(NOVA, "8")
    field(OUTA, "smallDest PP NMS")
}
record(aSub, "smallInput") {
    field(SNAM, "numericFftForward") field(FTA, "DOUBLE") field(NOA, "8")
    field(INPA, "fftInput NPP NMS") field(FTVA, "DOUBLE") field(NOVA, "8")
}
record(aSub, "badOutputType") {
    field(SNAM, "numericFftForward") field(FTA, "DOUBLE") field(NOA, "9")
    field(INPA, "fftInput NPP NMS") field(FTVA, "DOUBLE") field(NOVA, "8")
    field(OUTA, "integerDest PP NMS")
}
record(aSub, "badType") {
    field(SNAM, "numericFftForward") field(FTA, "LONG") field(NOA, "9")
    field(INPA, "fftInput NPP NMS") field(FTVA, "DOUBLE") field(NOVA, "8")
}
record(aSub, "constantInput") {
    field(SNAM, "numericFftForward") field(FTA, "DOUBLE") field(NOA, "9")
    field(FTVA, "DOUBLE") field(NOVA, "8")
}
record(aSub, "realSmallInput") {
    field(SNAM, "numericRealFftForward") field(FTA, "DOUBLE") field(NOA, "4") field(INPA, "realFftInput NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "8") field(FTVB, "DOUBLE") field(NOVB, "8")
}
record(aSub, "realSmallOutput") {
    field(SNAM, "numericRealFftForward") field(FTA, "DOUBLE") field(NOA, "5") field(INPA, "realFftInput NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "7") field(FTVB, "DOUBLE") field(NOVB, "8")
}
record(aSub, "realSmallScratch") {
    field(SNAM, "numericRealFftForward") field(FTA, "DOUBLE") field(NOA, "5") field(INPA, "realFftInput NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "8") field(FTVB, "DOUBLE") field(NOVB, "7")
}
record(aSub, "realSmallLink") {
    field(SNAM, "numericRealFftForward") field(FTA, "DOUBLE") field(NOA, "5") field(INPA, "realFftInput NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "8") field(OUTA, "smallDest PP NMS") field(FTVB, "DOUBLE") field(NOVB, "8")
}
record(aSub, "realScratchLink") {
    field(SNAM, "numericRealFftForward") field(FTA, "DOUBLE") field(NOA, "5") field(INPA, "realFftInput NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "8") field(FTVB, "DOUBLE") field(NOVB, "8") field(OUTB, "smallDest PP NMS")
}
