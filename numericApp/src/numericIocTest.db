record(waveform, "input") {
    field(FTVL, "DOUBLE")
    field(NELM, "8")
}
record(ao, "result") { field(PREC, "3") }
record(ao, "varianceResult") { field(PREC, "3") }
record(aSub, "varianceCalc") {
    field(SNAM, "numericVariance")
    field(FTA, "DOUBLE") field(NOA, "9")
    field(INPA, "input NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "1")
    field(OUTA, "varianceResult PP NMS")
}
record(aSub, "varianceSmall") {
    field(SNAM, "numericVariance")
    field(FTA, "DOUBLE") field(NOA, "2")
    field(INPA, "input NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "1")
}
record(aSub, "sdCalc") {
    field(SNAM, "numericStddev")
    field(FTA, "DOUBLE") field(NOA, "9") field(INPA, "input NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "1")
}
record(aSub, "popVarCalc") {
    field(SNAM, "numericPopulationVariance")
    field(FTA, "DOUBLE") field(NOA, "9") field(INPA, "input NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "1")
}
record(aSub, "popSdCalc") {
    field(SNAM, "numericPopulationStddev")
    field(FTA, "DOUBLE") field(NOA, "9") field(INPA, "input NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "1")
}
record(ao, "statsSample") {}
record(ao, "statsSequence") {}
record(ao, "statsReset") {}
record(aSub, "stats") {
    field(SNAM, "numericRunningStats")
    field(INPA, "statsSample NPP NMS")
    field(INPB, "statsSequence NPP NMS")
    field(INPC, "statsReset NPP NMS")
}
record(waveform, "ackEvent") { field(FTVL, "DOUBLE") field(NELM, "5") }
record(waveform, "ackSafeEvent") { field(FTVL, "DOUBLE") field(NELM, "5") field(FLNK, "ackSafeStats") }
record(waveform, "ackNoForward") { field(FTVL, "DOUBLE") field(NELM, "5") }
record(aSub, "ackSafeStats") {
    field(SNAM, "numericAcknowledgedStats")
    field(FTVL, "DOUBLE") field(NOVL, "11")
    field(FTA, "DOUBLE") field(NOA, "5") field(INPA, "ackSafeEvent NPP NMS")
}
record(ao, "ackSessionOut") {}
record(ao, "ackSequenceOut") {}
record(aSub, "ackStats") {
    field(SNAM, "numericAcknowledgedStats")
    field(FTA, "DOUBLE") field(NOA, "5") field(INPA, "ackEvent NPP NMS")
    field(OUTH, "ackSessionOut PP NMS") field(OUTI, "ackSequenceOut PP NMS")
}
record(aSub, "calc") {
    field(SNAM, "numericMean")
    field(FTA, "DOUBLE")
    field(NOA, "8")
    field(INPA, "input NPP NMS")
    field(FTVA, "DOUBLE")
    field(NOVA, "1")
    field(OUTA, "result PP NMS")
}

record(aSub, "bad") {
    field(SNAM, "numericMean")
    field(FTA, "LONG")
    field(FTVA, "DOUBLE")
}

record(aSub, "small") {
    field(SNAM, "numericMean")
    field(FTA, "DOUBLE")
    field(NOA, "2")
    field(INPA, "input NPP NMS")
    field(FTVA, "DOUBLE")
    field(NOVA, "1")
}

record(ao, "streamSample") {}
record(ao, "streamSequence") {}
record(ao, "streamReset") {}
record(ao, "streamMeanOut") {}
record(ao, "streamCountOut") {}
record(aSub, "stream") {
    field(SNAM, "numericRunningMean")
    field(FTA, "DOUBLE") field(FTB, "DOUBLE") field(FTC, "DOUBLE")
    field(INPA, "streamSample NPP NMS")
    field(INPB, "streamSequence NPP NMS")
    field(INPC, "streamReset NPP NMS")
    field(FTVA, "DOUBLE") field(FTVB, "DOUBLE")
    field(OUTA, "streamMeanOut PP NMS")
    field(OUTB, "streamCountOut PP NMS")
}
record(aSub, "stream2") {
    field(SNAM, "numericRunningMean")
    field(INPA, "streamSample NPP NMS")
    field(INPB, "streamSequence NPP NMS")
    field(INPC, "streamReset NPP NMS")
}
record(aSub, "streamWave") {
    field(SNAM, "numericRunningMean")
    field(INPA, "input NPP NMS")
}
