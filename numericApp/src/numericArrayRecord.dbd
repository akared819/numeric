recordtype(numericArray) {
    include "dbCommon.dbd"
    field(VAL, DBF_NOACCESS) {
        prompt("Array result")
        asl(ASL0)
        special(SPC_DBADDR)
        extra("void *val")
    }
    field(INP, DBF_INLINK) { prompt("Input array link") promptgroup("40 - Input") }
    field(OP, DBF_STRING) { prompt("Registry operation") size(40) initial("moving_mean") special(SPC_NOMOD) }
    field(ARGA, DBF_STRING) { prompt("Argument A") size(40) }
    field(ARGB, DBF_STRING) { prompt("Argument B") size(40) }
    field(ARGC, DBF_STRING) { prompt("Argument C") size(40) }
    field(ARGD, DBF_STRING) { prompt("Argument D") size(40) }
    field(ARGE, DBF_STRING) { prompt("Argument E") size(40) }
    field(ARGF, DBF_STRING) { prompt("Argument F") size(40) }
    field(ARGG, DBF_STRING) { prompt("Argument G") size(40) }
    field(ARGH, DBF_STRING) { prompt("Argument H") size(40) }
    field(ARGI, DBF_STRING) { prompt("Argument I") size(40) }
    field(ARGJ, DBF_STRING) { prompt("Argument J") size(40) }
    field(ARGK, DBF_STRING) { prompt("Argument K") size(40) }
    field(ARGL, DBF_STRING) { prompt("Argument L") size(40) }
    field(ARGM, DBF_STRING) { prompt("Argument M") size(40) }
    field(ARGN, DBF_STRING) { prompt("Argument N") size(40) }
    field(ARGO, DBF_STRING) { prompt("Argument O") size(40) }
    field(ARGP, DBF_STRING) { prompt("Argument P") size(40) }
    field(NMAX, DBF_ULONG) { prompt("Maximum input elements") initial("1024") special(SPC_NOMOD) }
    field(OMAX, DBF_ULONG) { prompt("Maximum output elements") initial("1024") special(SPC_NOMOD) }
    field(NIN, DBF_ULONG) { prompt("Input elements used") special(SPC_NOMOD) }
    field(NORD, DBF_ULONG) { prompt("Valid output elements") special(SPC_NOMOD) }
    field(WIN, DBF_DOUBLE) { prompt("Odd window length") initial("3") }
    field(ALPH, DBF_DOUBLE) { prompt("Gaussian alpha") initial("1.1774100225154747") }
    field(HMIN, DBF_DOUBLE) { prompt("Histogram lower bound") initial("0") }
    field(HMAX, DBF_DOUBLE) { prompt("Histogram upper bound") initial("1") }
    field(NBIN, DBF_DOUBLE) { prompt("Histogram bin count") initial("10") }
    field(PREC, DBF_SHORT) { prompt("Display precision") initial("6") }
    field(RPVT, DBF_NOACCESS) { prompt("Record private state") special(SPC_NOMOD) extra("void *rpvt") }
}
