# SPDX-License-Identifier: GPL-3.0-or-later
record(waveform, "$(P)interpX") {
    field(FTVL, "DOUBLE")
    field(NELM, "4")
}

record(waveform, "$(P)interpY") {
    field(FTVL, "DOUBLE")
    field(NELM, "4")
}

record(ao, "$(P)interpQuery") {
    field(VAL, "2")
}

record(ao, "$(P)interpResult") {
    field(PREC, "6")
}

record(aSub, "$(P)interpEval") {
    field(SNAM, "numericInterpLinear")
    field(FTA, "DOUBLE")
    field(NOA, "5")
    field(INPA, "$(P)interpX NPP NMS")
    field(FTB, "DOUBLE")
    field(NOB, "5")
    field(INPB, "$(P)interpY NPP NMS")
    field(FTC, "DOUBLE")
    field(NOC, "1")
    field(INPC, "$(P)interpQuery NPP NMS")
    field(FTVA, "DOUBLE")
    field(NOVA, "1")
    field(OUTA, "$(P)interpResult PP NMS")
}
