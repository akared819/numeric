# Four complex samples, interleaved real/imaginary DOUBLE values.
record(waveform, "$(P)fftInput") { field(FTVL, "DOUBLE") field(NELM, "8") }
record(waveform, "$(P)fftOutput") { field(FTVL, "DOUBLE") field(NELM, "8") }
record(aSub, "$(P)fftForward") {
    field(SNAM, "numericFftForward")
    field(FTA, "DOUBLE") field(NOA, "9") field(INPA, "$(P)fftInput NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "8") field(OUTA, "$(P)fftOutput PP NMS")
}
record(waveform, "$(P)ifftOutput") { field(FTVL, "DOUBLE") field(NELM, "8") }
record(aSub, "$(P)fftInverse") {
    field(SNAM, "numericFftInverse")
    field(FTA, "DOUBLE") field(NOA, "9") field(INPA, "$(P)fftOutput NPP NMS")
    field(FTVA, "DOUBLE") field(NOVA, "8") field(OUTA, "$(P)ifftOutput PP NMS")
}
