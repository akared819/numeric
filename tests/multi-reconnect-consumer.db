record(waveform, "multiReconnect:local") {
    field(FTVL, "DOUBLE")
    field(NELM, "4")
}
record(numericScalar, "multiReconnect:correlation") {
    field(OP, "correlation")
    field(INPA, "multiReconnect:local NPP NMS")
    field(INPB, "multiReconnect:remote CA NPP NMS")
    field(NMAX, "4")
}
record(numericArray, "multiReconnect:fit") {
    field(OP, "linear_fit")
    field(INPA, "multiReconnect:local NPP NMS")
    field(INPB, "multiReconnect:remote CA NPP NMS")
    field(NMAX, "4")
    field(OMAX, "6")
}
record(numericScalar, "multiReconnect:floatMean") {
    field(OP, "mean")
    field(INP, "multiReconnect:remoteFloat CA NPP NMS")
    field(NMAX, "4")
}
